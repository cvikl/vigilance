<!doctype html>
<html><head><meta charset="utf-8">
<style>
{{ font_css }}
body{margin:0;width:{{ width }}px;height:{{ height }}px;overflow:hidden;background:#fff;color:#111;}
.page{box-sizing:border-box;position:relative;width:{{ width }}px;height:{{ height }}px;padding:{{ pad_top }}px {{ pad_side }}px;font-family:'{{ body_font }}';font-size:{{ font_size }}px;line-height:{{ line_height }};}
.w{white-space:nowrap;}
.ruled{background-image:repeating-linear-gradient(to bottom,transparent 0 {{ rule_px - 1 }}px,#c5cfdd {{ rule_px - 1 }}px {{ rule_px }}px);background-origin:content-box;}
.letterhead{font-family:'Sans';font-size:16px;line-height:1.3;display:flex;justify-content:space-between;border-bottom:2px solid #333;padding-bottom:10px;margin-bottom:26px;}
.letterhead .trust{font-weight:bold;font-size:19px;}
.body{}
.title{font-weight:bold;font-size:1.15em;margin:0 0 0.8em 0;}
.fields{margin:0 0 0.8em 0;}
.para{margin:0 0 0.8em 0;}
.footer{position:absolute;left:{{ pad_side }}px;right:{{ pad_side }}px;bottom:{{ footer_h - 30 }}px;font-family:'Sans';font-size:13px;color:#555;display:flex;justify-content:space-between;}
{% block extra_css %}{% endblock %}
</style></head>
<body><div class="page{% if ruled %} ruled{% endif %}">
<div class="letterhead"><div><span class="trust">{{ trust }}</span><br>{{ dept }}</div>
<div>Hospital No: {{ meta.patient_id|e }}<br>Doc: {{ meta.doc_id|e }}<br>{{ authored }}</div></div>
<div class="body">{{ body }}</div>
<div class="footer"><span>{{ label }}</span><span>Page {{ page_no }} of {{ page_count }}</span></div>
</div></body></html>
